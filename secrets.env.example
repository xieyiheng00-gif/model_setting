# API keys for model_setting. Copy to secrets.env (gitignored) or, better, create it with
#     python scripts/setup_secrets.py          (hidden input, private file permissions)
# Never commit the filled-in file, never paste keys into configs, chat or command lines.
# Use keys with the smallest scope that works, and a separate key per machine where possible.

# Weights & Biases: https://wandb.ai/authorize  (live training dashboards)
WANDB_API_KEY=

# Hugging Face: https://huggingface.co/settings/tokens  ("Read" token; downloads the private
# dataset xie1231/llm-10b-packed with `hf download`)
HF_TOKEN=

# GitHub: https://github.com/settings/personal-access-tokens  (fine-grained token, repository
# xieyiheng00-gif/model_setting only, Contents: read - or read/write if the GPU box pushes)
GITHUB_TOKEN=
